{
  "name": "bsc-arbitrage-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "BSC Arbitrage Bot: PancakeSwap V2 + Biswap integration, scanner, Telegram alerts, CSV logs, tests, deployment.",
  "main": "bot/scanner.ts",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "echo \"no lint configured\"",
    "deploy:testnet": "hardhat run --network bscTestnet scripts/deploy.ts",
    "deploy:mainnet": "hardhat run --network bscMainnet scripts/deploy.ts",
    "deploy:local-demo": "hardhat run --network localhost scripts/deploy-demo.ts",
    "start:ui": "node server.js",
    "start:scanner": "ts-node --project tsconfig.json bot/scanner.ts",
    "start:executor": "ts-node --project tsconfig.json bot/executor.ts",
    "verify:deploy": "hardhat run --network bscTestnet scripts/verify_deploy.ts"
  },
  "author": "adej0",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@types/node": "^18.0.0",
    "chai": "^4.5.0",
    "hardhat": "^3.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },

  "dependencies": {
    "@openzeppelin/contracts": "^4.9.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.0.0",
    "ethers": "^6.9.0",
    "node-telegram-bot-api": "^0.61.0"
  }
}
