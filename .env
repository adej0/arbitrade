# Local environment variables for the BSC Arbitrage Bot
# Copy this file to .env and fill the values before running.

# RPC endpoints
RPC_URL_TESTNET=https://data-seed-prebsc-1-s1.binance.org:8545/
RPC_URL_MAINNET=https://bsc-dataseed.binance.org/

# Deployer / Bot private key (use testnet key first)
PRIVATE_KEY=

# Telegram bot
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# Arbitrage bot parameters
MIN_PROFIT_NATIVE_WEI=10000000000000000   # 0.01 BNB (native units)
SLIPPAGE_BPS=50                           # 0.5% default slippage in basis points
GAS_PRICE_GWEI=5                          # Default gas price to estimate tx cost (in gwei)
CSV_LOG=./trades.csv

# Contract addresses (fill after deploy or use known routers)
PANCAKESWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
BISWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
WBNB_ADDRESS=0x0000000000000000000000000000000000000000
ARBITRAGE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Tokens to scan (comma-separated addresses)
SCAN_TOKENS=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000

# Safety & execution
AUTO_EXECUTE=false            # set true to allow the executor to send transactions (dangerous)
EXECUTOR_DRY_RUN=true         # if true, executor will only simulate/estimate gas & profit, not send tx
MAX_SLIPPAGE_BPS=200          # maximum allowed slippage for automatic execution (e.g. 2% = 200 bps)

# Optional: BscScan API Key for verification script
BSC_ETHERSCAN_API_KEY=

# Optional: Alerting
ALERT_ONLY=true               # if true, executor will only notify, not attempt txs even if AUTO_EXECUTE=true

# Optional: Gas limit override for executeArbitrage call (leave unset to auto-estimate)
EXECUTE_GAS_LIMIT=

# CI / environment
GITHUB_ACTIONS=false
