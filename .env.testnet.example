# Example testnet .env file (do NOT commit real secrets)
# Copy to .env and fill values when testing on BSC Testnet.

RPC_URL_TESTNET=https://data-seed-prebsc-1-s1.binance.org:8545/
RPC_URL_MAINNET=

# Use a testnet-only private key with a small balance
PRIVATE_KEY=0xyour_testnet_private_key_here

# Telegram bot (for alerts)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Bot parameters
MIN_PROFIT_NATIVE_WEI=10000000000000000
SLIPPAGE_BPS=50
GAS_PRICE_GWEI=5
CSV_LOG=./trades.csv

# Known testnet router and WBNB addresses should be filled here
PANCAKESWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
BISWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
WBNB_ADDRESS=0x0000000000000000000000000000000000000000
ARBITRAGE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Tokens to scan (comma-separated)
SCAN_TOKENS=0x0000000000000000000000000000000000000000

# Safety flags
AUTO_EXECUTE=false
EXECUTOR_DRY_RUN=true
ALERT_ONLY=true

# Optional Etherscan API key for verification
BSC_ETHERSCAN_API_KEY=
